{
  "name": "dynamic-pages",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "set TSC_COMPILE_ON_ERROR=true && jest --coverage --config jest.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --ignore-path .gitignore ./packages/**/*.{js,json,ts,tsx}",
    "format": "npm run prettier -- --write",
    "publish:library": "npm run build && npm publish",
    "pre-commit": "lint-staged",
    "watch": "webpack --mode=development --config webpack.dev.config.js"
  },
  "lint-staged": {
    "**/*.+(js|json|ts|tsx)": [
      "npm run format"
    ]
  },
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/cli": "7.28.0",
    "@babel/core": "7.28.0",
    "@babel/plugin-transform-runtime": "7.28.0",
