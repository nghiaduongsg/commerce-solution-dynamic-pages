  "typings": "src/**/*.d.ts",
  "jest": {
    "testPathIgnorePatterns": [
      "packages/_jestHelpers"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "packages/**/*.{ts,tsx}"
    ],
    "maxWorkers": 2
  },
  "jest-junit": {
    "outputDirectory": "coverage/junit",
    "outputName": "junit.xml",
    "usePathForSuiteName": "true"
  },
  "overrides": {
    "react-is": "^19.0.0",
    "underscore": "1.13.8"
  }
}
