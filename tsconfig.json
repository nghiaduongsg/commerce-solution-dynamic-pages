{
  "compilerOptions": {
    "baseUrl": "packages",
    "module": "commonjs",
    "jsx": "react",
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "emitDeclarationOnly": false,
    "noImplicitAny": false,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@_jestHelpers/*": ["./_jestHelpers/*"],
      "tslib": ["./node_modules/tslib/tslib.d.ts"],
      "@pkg-common/*": ["./common/src/*"],
      "@pkg-constants/*": ["./constants/*"],
      "@pkg-core/*": ["./core/*"],
      "@pkg-entity/*": ["./entity/*"],
      "@pkg-list-types/*": ["./list/src/types.d.ts"],
      "@pkg-form/*": ["./form/*"],
      "@pkg-list/*": ["./list/*"],
      "@pkg-layout/*": ["./layout/*"],
      "@pkg-setup/*": ["./setup/*"],
      "@pkg-theme/*": ["./theme/*"],
      "@translations/*": ["./core/translations/*"]
    },
    "allowJs": true,
    "downlevelIteration": true,
    "target": "es5",
    "lib": ["es2015", "dom"],
    "declaration": true,
    "declarationMap": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true
  },
  "include": ["packages"],
  "exclude": [
    "lib",
    "dist",
    "node_modules",
    "build",
    "scripts",
    "acceptance-tests",
    "webpack",
    "jest",
    "packages/setupTests.ts"
  ]
}
